{
  "manifest_version": 3,
  "name": "Grammy — Instagram AI assistant",
  "version": "0.1.0",
  "description": "A voice-first AI assistant that lives inside Instagram: it reads the post you are on and talks to you about it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "offscreen"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {
    "service_worker": "src/bg/service-worker.js",
    "type": "module"
  },
  "options_page": "src/onboarding/index.html",
  "action": {
    "default_title": "Grammy — open settings"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/*", "src/*", "src/*/*", "src/*/*/*"],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}

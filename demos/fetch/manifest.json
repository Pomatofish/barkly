{
  "manifest_version": 3,
  "name": "IG Buddy Spike",
  "version": "0.3",
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["injected.js"],
    "matches": ["https://www.instagram.com/*"]
  }]
}
{
  "manifest_version": 3,
  "name": "Grammy Overlay Test",
  "version": "0.1.0",
  "description": "Hackathon prototype: an AI-assistant style overlay that points at and highlights Instagram buttons.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Grammy Overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
